{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "streamlit", "run", "ui/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501,
      "url": "http://127.0.0.1:8501"
    }
  ]
}
