# Copy this file to .env and fill in your own values. Never commit .env.
# Sprint 1-2 need ONLY the two AI keys below; everything else has a working default.

# --- AI providers (both free) --- [needed now]
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Models (change here, not in code) ---
TEXT_MODEL=openai/gpt-oss-120b
VISION_MODEL=gemini-3.5-flash-lite

# --- Database (local Docker by default) ---
DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5433/civic

# --- Vector store: Qdrant (local Docker by default; set both for Qdrant Cloud) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- Monitoring: Langfuse (cloud.langfuse.com, free) --- [from Sprint 4; tracing is off while empty]
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Privacy --- [from Sprint 3] generate once with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_KEY=

# --- App ---
# APP_ENV: local | prod (prod refuses to start if any secret is missing or weak)
# AUTH_MODE: dev (name login, local only) | supabase (email code login)
APP_ENV=local
AUTH_MODE=dev
API_URL=http://127.0.0.1:8010
LOCAL_MODELS=on

# --- Deploy only: leave empty locally. Which dashboard each one goes in: docs/DEPLOY.md ---
# SUPABASE_URL = https://<project>.supabase.co, SUPABASE_ANON_KEY = its anon key (API only)
# TURNSTILE_SECRET (API only) and TURNSTILE_SITE_KEY (UI only, public) from Cloudflare
# ALLOWED_ORIGINS = the UI's URL, e.g. https://<app>.streamlit.app
SUPABASE_URL=
SUPABASE_ANON_KEY=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
ALLOWED_ORIGINS=
